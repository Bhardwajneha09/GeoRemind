# ============================================
# Location-Based Reminder System — Environment
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=geo_reminders
DB_USER=root
DB_PASS=secret

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Firebase Cloud Messaging (optional — leave blank to disable)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Email / SMTP (leave blank in dev to use Ethereal auto-account)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@georemind.app
