PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=location_reminders
DB_USER=root
DB_PASS=password

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# Firebase Admin SDK (Optional - will stub if not provided)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Nodemailer SMTP Configuration (Production only; Development uses Ethereal test account)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret
